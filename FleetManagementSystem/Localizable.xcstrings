    "You are all caught up. New assignments will appear here." : {
      "extractionState" : "manual",
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप अपडेट हैं। नए असाइनमेंट यहां दिखेंगे।"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ಅಪ್ಡೇಟ್ ಆಗಿದ್ದೀರಿ. ಹೊಸ ನಿಯೋಜನೆ ಇಲ್ಲಿ ಕಾಣಿಸುತ್ತವೆ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही अपडेट आहात. नवीन सोपवणी इथे दिसतील."
          }
        }
      }
    },
